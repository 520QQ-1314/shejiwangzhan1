.src-dribbble{background:#ea4c89;color:#fff}
.src-zcool{background:#1d8ce0;color:#fff}
.src-uicn{background:#ff6633;color:#fff}

/* 收藏夹下载工具栏 */
.fav-toolbar{position:sticky;top:64px;z-index:20;background:#fff;border-bottom:1px solid #e5e7eb;padding:12px 16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.fav-toolbar button{padding:6px 14px;border-radius:99px;font-size:13px;cursor:pointer;border:1px solid #e5e7eb;background:#fff;transition:all .15s}
.fav-toolbar button:hover{background:#f3f4f6}
.fav-toolbar button.primary{background:#e60023;color:#fff;border-color:#e60023}
.fav-toolbar button.primary:hover{background:#c5001f}
.fav-toolbar button:disabled{opacity:.5;cursor:not-allowed}

/* 多选模式 */
.pin.selectable{cursor:pointer}
.pin.selectable::after{content:'';position:absolute;top:8px;right:8px;width:22px;height:22px;border:2px solid #fff;border-radius:50%;background:rgba(0,0,0,.3);transition:all .15s}
.pin.selected::after{background:#e60023;border-color:#e60023;content:'✓';color:#fff;font-size:14px;display:flex;align-items:center;justify-content:center}

/* 下载进度浮窗 */
.download-toast{position:fixed;bottom:24px;right:24px;background:#111;color:#fff;padding:12px 20px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);z-index:200;display:flex;align-items:center;gap:10px;font-size:14px}
.download-toast .spinner-small{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
